# Copy to server/.env for local development. NEVER commit real values.
NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string and database name
MONGO_URI=
MONGO_DB_NAME=
# Resend API key and a sender address on a Resend-verified domain
RESEND_API_KEY=
EMAIL_FROM=
# Notification recipient(s), comma-separated
EMAIL_TO=
# Comma-separated exact origins allowed to call the API (production site, Vercel preview, ...).
# A '*' stands for exactly one DNS label, e.g. https://jolu-machineries-website-*-jolu-group.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
