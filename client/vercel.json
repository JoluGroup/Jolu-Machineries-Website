{
  "routes": [
    { "handle": "filesystem" },
    { "src": "/((?!_img/)[^.]+?)/?", "dest": "/$1.html", "check": true },
    { "src": "/((?!_img/).*)", "dest": "/404.html", "status": 404 },
    { "handle": "hit" },
    {
      "src": "/_img/.+-\\d+\\.[0-9a-f]{16}\\.webp",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    }
  ]
}
